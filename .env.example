# ==============================================================
# Multi-Agent Enterprise System Environment Configuration
# ==============================================================

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively supported standard environment variable
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Identifiers
# Supported models: gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.8-flash
RESEARCHER_MODEL=gemini-3.1-flash-lite
EMAIL_MODEL=gemini-3.1-flash-lite
SCHEDULER_MODEL=gemini-3.1-flash-lite

# Execution & Tool Options
# Options: 'live' (uses live LLM calls) or 'auto' (falls back smoothly via Safe-Hand)
EXECUTION_MODE=auto

# Output directory for agent deliverables
OUTPUT_DIR=output

# Optional SMTP Settings for Live Email Transmission
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
